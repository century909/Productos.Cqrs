@baseUrl = http://localhost:5105

# La tabla public.products usa id INTEGER IDENTITY: el id lo asigna PostgreSQL.
# Tras crear un producto, usa el id devuelto en la cabecera Location / body.
@productoId = 1

### Listar todos los productos
GET {{baseUrl}}/api/productos

### Buscar productos por nombre (coincidencia parcial, case-insensitive)
GET {{baseUrl}}/api/productos?nombre=teclado

### Obtener producto
GET {{baseUrl}}/api/productos/{{productoId}}

### Obtener producto inexistente (404)
GET {{baseUrl}}/api/productos/999999

### Crear producto (201)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Teclado Mecanico",
  "descripcion": "Teclado con switches rojos",
  "precio": 850000,
  "stockInicial": 40
}

### Crear con nombre repetido (400, indice ux_products_name_lower)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Teclado Mecanico",
  "descripcion": "Otra descripcion",
  "precio": 900000,
  "stockInicial": 10
}

### Crear con nombre vacio (400 formato)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "",
  "precio": 850000,
  "stockInicial": 40
}

### Crear con precio negativo (400 formato, ck_products_price)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Producto invalido",
  "precio": -10,
  "stockInicial": 40
}

### Crear con stock negativo (400 formato, ck_products_stock)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Producto invalido 2",
  "precio": 1000,
  "stockInicial": -1
}

### Actualizar producto (PUT, 200)
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "Teclado Mecanico Pro",
  "descripcion": "Switches rojos / layout ISO",
  "precio": 920000
}

### Actualizar producto inexistente (404)
PUT {{baseUrl}}/api/productos/999999
Content-Type: application/json

{
  "nombre": "Fantasma",
  "descripcion": null,
  "precio": 500000
}

### Actualizar con nombre vacio (400 formato)
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "",
  "precio": 920000
}

### Actualizar solo el precio (PATCH, 200)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "precio": 950000
}

### PATCH producto inexistente (404)
PATCH {{baseUrl}}/api/productos/999999
Content-Type: application/json

{
  "precio": 1000
}

### Ajustar stock: entrada de 10 (200)
PATCH {{baseUrl}}/api/productos/{{productoId}}/stock
Content-Type: application/json

{
  "cantidad": 10
}

### Ajustar stock: salida de 5 (200)
PATCH {{baseUrl}}/api/productos/{{productoId}}/stock
Content-Type: application/json

{
  "cantidad": -5
}

### Ajustar stock dejando saldo negativo (422 regla de negocio)
PATCH {{baseUrl}}/api/productos/{{productoId}}/stock
Content-Type: application/json

{
  "cantidad": -999999
}

### Ajustar stock con cantidad cero (400 formato)
PATCH {{baseUrl}}/api/productos/{{productoId}}/stock
Content-Type: application/json

{
  "cantidad": 0
}

### Eliminar producto (204)
DELETE {{baseUrl}}/api/productos/{{productoId}}

### Eliminar producto inexistente (404)
DELETE {{baseUrl}}/api/productos/999999
