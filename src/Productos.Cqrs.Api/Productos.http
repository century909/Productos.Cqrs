@baseUrl = http://localhost:5105
@productoId = 11111111-1111-1111-1111-111111111111

### Listar productos de una categoria
GET {{baseUrl}}/api/productos?categoria=Electronica

### Listar todos los productos
GET {{baseUrl}}/api/productos

### Obtener producto
GET {{baseUrl}}/api/productos/{{productoId}}

### Movimientos de stock
GET {{baseUrl}}/api/productos/{{productoId}}/movimientos

### Ajustar stock: registrar una salida (200) y crear movimiento
POST {{baseUrl}}/api/productos/33333333-3333-3333-3333-333333333333/movimientos
Content-Type: application/json

{
  "cantidad": -5,
  "motivo": "Venta mostrador"
}

### Ajustar stock con cantidad cero (400 formato)
POST {{baseUrl}}/api/productos/33333333-3333-3333-3333-333333333333/movimientos
Content-Type: application/json

{
  "cantidad": 0,
  "motivo": "Prueba"
}

### Ajustar stock de producto descontinuado (422 regla de negocio)
POST {{baseUrl}}/api/productos/22222222-2222-2222-2222-222222222222/movimientos
Content-Type: application/json

{
  "cantidad": 1,
  "motivo": "Reposicion"
}

### Descontinuar producto con stock (422 regla de negocio)
POST {{baseUrl}}/api/productos/33333333-3333-3333-3333-333333333333/descontinuar
Content-Type: application/json

{
  "motivo": "Dejo de venderse"
}

### Descontinuar producto ya descontinuado (422 regla de negocio)
POST {{baseUrl}}/api/productos/22222222-2222-2222-2222-222222222222/descontinuar
Content-Type: application/json

{
  "motivo": "Segundo intento"
}

### Descontinuar sin motivo (400 formato)
POST {{baseUrl}}/api/productos/{{productoId}}/descontinuar
Content-Type: application/json

{
  "motivo": ""
}

### Crear producto
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Teclado Mecanico",
  "descripcion": "Teclado con switches rojos",
  "categoria": "Electronica",
  "precio": 850000,
  "stockInicial": 40
}

### Crear con precio fuera de rango (422 regla de negocio)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Teclado Mecanico",
  "categoria": "Electronica",
  "precio": 10,
  "stockInicial": 40
}

### Crear con categoria invalida (400 formato)
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Teclado Mecanico",
  "categoria": "Juguetes",
  "precio": 850000,
  "stockInicial": 40
}

### Producto inexistente (404)
GET {{baseUrl}}/api/productos/99999999-9999-9999-9999-999999999999

### Eliminar producto descontinuado y sin stock (204)
DELETE {{baseUrl}}/api/productos/22222222-2222-2222-2222-222222222222

### Eliminar producto activo (422 regla de negocio)
DELETE {{baseUrl}}/api/productos/11111111-1111-1111-1111-111111111111

### Eliminar producto inexistente (404)
DELETE {{baseUrl}}/api/productos/99999999-9999-9999-9999-999999999999

### Ciclo de vida completo sobre el producto 1111 (ejecutar en orden)
# 1) Dejar el stock en cero (200)
POST {{baseUrl}}/api/productos/{{productoId}}/movimientos
Content-Type: application/json

{
  "cantidad": -20,
  "motivo": "Ajuste a cero para descontinuar"
}

# 2) Descontinuar sin stock (200)
POST {{baseUrl}}/api/productos/{{productoId}}/descontinuar
Content-Type: application/json

{
  "motivo": "Fin de vida del producto"
}

# 3) Eliminar descontinuado y sin stock (204)
DELETE {{baseUrl}}/api/productos/{{productoId}}

### Actualizar producto (PUT, 200)
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "Laptop Pro 15",
  "descripcion": "16 GB RAM / 512 GB SSD",
  "categoria": "Electronica",
  "precio": 4200000
}

### Actualizar producto inexistente (404)
PUT {{baseUrl}}/api/productos/99999999-9999-9999-9999-999999999999
Content-Type: application/json

{
  "nombre": "Fantasma",
  "categoria": "Hogar",
  "precio": 500000
}

### Actualizar con nombre vacio (400 formato)
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "",
  "categoria": "Electronica",
  "precio": 4200000
}

### Actualizar con precio fuera de rango (422 negocio)
PUT {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "nombre": "Laptop Pro 15",
  "categoria": "Electronica",
  "precio": 10
}

### Actualizar solo el precio (PATCH, 200)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "precio": 4500000
}

### PATCH producto inexistente (404)
PATCH {{baseUrl}}/api/productos/99999999-9999-9999-9999-999999999999
Content-Type: application/json

{
  "precio": 1000
}

### PATCH precio fuera de rango (422 negocio)
PATCH {{baseUrl}}/api/productos/{{productoId}}
Content-Type: application/json

{
  "precio": 5
}